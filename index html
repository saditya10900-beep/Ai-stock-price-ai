}
.hero h1{font-size:35px;color:#075b37;margin-bottom:12px}
.hero p{color:#53645a;font-size:16px}
.search{
 margin:25px auto;max-width:650px;
 display:flex;gap:8px;padding:5px;
 background:white;border-radius:12px;
 box-shadow:0 3px 15px #0001;
}
.search input{
 flex:1;min-width:0;border:0;outline:0;
 padding:14px;font-size:16px;
}
button{
