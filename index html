 background:#087c49;color:white;
 cursor:pointer;font-size:15px;
}
button:hover{background:#055d36}
.container{max-width:1150px;margin:auto;padding:30px 18px}
.section-title{font-size:25px;color:#075b37;margin-bottom:20px}
.categories{
 display:flex;gap:10px;flex-wrap:wrap;margin-bottom:25px;
}
.categories button{background:white;color:#075b37;border:1px solid #b9d8c5}
.categories button.active,.categories button:hover{
 background:#087c49;color:white;
}
.grid{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
 gap:18px;
}
.card{
 background:white;border-radius:13px;padding:20px;
 box-shadow:0 3px 14px #0000000c;
 border:1px solid #e4eee7;
}
.card .emoji{font-size:30px;margin-bottom:10px}
.card h3{color:#075b37;margin-bottom:10px}
.card p{color:#607067;line-height:1.6;font-size:14px}
.card a{
 display:inline-block;margin-top:15px;
 color:#087c49;text-decoration:none;font-weight:bold;
}
.tag{
 display:inline-block;background:#e3f5e9;
 color:#087c49;padding:5px 9px;
 border-radius:20px;font-size:12px;margin-bottom:12px;
}
.ai-section{
 background:#e9f5ec;padding:30px 15px;
}
.chatbox{
 max-width:750px;margin:auto;background:white;
 border-radius:15px;overflow:hidden;
 box-shadow:0 3px 20px #0001;
}
.chat-head{
 background:#075b37;color:white;padding:18px;
}
.chat-head p{font-size:13px;margin-top:5px;color:#d8f4e3}
.settings{padding:15px;display:grid;gap:10px}
.settings label{font-size:13px;font-weight:bold}
.settings input,.settings select{
 padding:12px;border:1px solid #ccd9d0;
 border-radius:8px;width:100%;background:white;
}
.chat-messages{
 height:350px;overflow-y:auto;padding:15px;
 background:#fbfdfb;
}
.msg{
 padding:12px 14px;border-radius:12px;
 margin-bottom:12px;max-width:90%;
 line-height:1.6;white-space:pre-wrap;
 overflow-wrap:anywhere;
}
.user{background:#dff3e5;margin-left:auto}
.bot{background:#edf0ed;margin-right:auto}
.chat-input{
 display:flex;gap:8px;padding:12px;
 border-top:1px solid #eee;
}
.chat-input input{
 flex:1;min-width:0;padding:13px;
 border:1px solid #ddd;border-radius:8px;
 outline:0;
}
.quick{
 padding:0 15px 15px;display:flex;gap:8px;flex-wrap:wrap
}
.quick button{font-size:12px;padding:9px;background:#e6f5eb;color:#075b37}
footer{
 background:#073f2a;color:white;text-align:center;
 padding:25px 15px;line-height:1.8;
}
.note{font-size:12px;color:#69756d;margin-top:12px}
.hidden{display:none}
@media(max-width:600px){
 .hero h1{font-size:27px}
 .logo{font-size:21px}
 .chat-messages{height:320px}
 .chat-input button{padding:10px}
}
</style>
</head>

<body>

<header>
 <div class="nav">
  <div class="logo">🌾 GRAM <span>BAZAR</span></div>
  <nav>
   <a href="#home">होम</a>
   <a href="#schemes">सरकारी योजनाएँ</a>
