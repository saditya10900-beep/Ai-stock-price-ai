 <div class="search">
  <input id="searchInput" placeholder="योजना का नाम खोजें...">
  <button onclick="searchSchemes()">खोजें</button>
 </div>
 <p>किसान | विद्यार्थी | महिला | युवा | बुजुर्ग</p>
</section>

<main class="container" id="schemes">
 <h2 class="section-title">📋 प्रमुख सरकारी योजनाएँ</h2>

 <div class="categories">
  <button class="active" onclick="filterSchemes('सभी',this)">सभी</button>
  <button onclick="filterSchemes('किसान',this)">किसान</button>
  <button onclick="filterSchemes('शिक्षा',this)">शिक्षा</button>
  <button onclick="filterSchemes('महिला',this)">महिला</button>
  <button onclick="filterSchemes('आवास',this)">आवास</button>
