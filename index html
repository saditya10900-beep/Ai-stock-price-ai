<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
 font-family:Arial,sans-serif;
 background:#f4f7f2;color:#17251d;
}
header{
 background:linear-gradient(120deg,#075b37,#07834d);
 color:white;padding:20px 6%;
}
.nav{
 display:flex;justify-content:space-between;
 align-items:center;flex-wrap:wrap;gap:12px;
}
.logo{font-size:25px;font-weight:bold}
.logo span{color:#ffda68}
.nav a{color:white;text-decoration:none;margin:8px}
